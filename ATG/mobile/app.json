{
  "expo": {
    "name": "ATG Traders",
    "slug": "atg-traders",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "atgtraders",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-video",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atg.traders"
    },
    "android": {
      "package": "com.atg.traders",
      "adaptiveIcon": {
        "backgroundColor": "#A67C00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "239b3a32-5f80-464a-8e17-31fb92d9d4f9"
      }
    }
  }
}
