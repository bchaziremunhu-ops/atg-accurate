# ---- ATG Traders backend environment ----
# Copy to .env and fill in real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CLIENT_ORIGIN=http://localhost:5273

# MySQL 8.0+ is required in development and production. Create the database
# with utf8mb4_0900_bin collation and use a dedicated non-root account.
# Keep real credentials in the ignored server/.env and URL-encode special characters.
DATABASE_URL="mysql://atg_app:replace-with-a-url-encoded-password@127.0.0.1:3306/atg"

# Auth
JWT_SECRET=change-me-in-production-please
JWT_REFRESH_SECRET=change-me-too-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Payments (Stripe test mode) ----
# Get these from https://dashboard.stripe.com/test/apikeys  (INTEGRATION: API KEY REQUIRED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_CURRENCY=usd

# ---- Push notifications (Web Push / VAPID) ----
# Generate with: npx web-push generate-vapid-keys   (INTEGRATION: KEYS REQUIRED)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@atgtraders.example

# ---- Mobile push (Firebase Cloud Messaging) ----
# INTEGRATION: Firebase service account JSON path or inline credentials required
FCM_SERVER_KEY=

# ---- Deposits / withdrawals provider ----
# Manual by default: no API keys needed, every request stays PENDING until an
# administrator confirms the real payment. Register a real PSP adapter in
# src/services/payments/providers.ts before enabling a live provider.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# ---- Live market data (OPTIONAL — disabled by default) ----
# ATG publishes signals manually and never invents prices. A chart only appears
# when a real feed is connected here.
MARKET_DATA_PROVIDER=disabled
MARKET_DATA_URL=
MARKET_DATA_API_KEY=

# ---- Broker funding: Deriv / Weltrade deposits & withdrawals ----
# MANUAL by default. Nothing is ever marked Completed without a signed provider
# webhook or a recorded admin reconciliation — see docs/BROKER_FUNDING.md.
#
# Gateway selection: `manual` (admin verifies everything) unless credentials for
# a broker are present, in which case that broker's requests are routed to it.
BROKER_FUNDING_PROVIDER=manual
BROKER_CURRENCY=USD

# Deriv (https://api.deriv.com) — gateway stays DISABLED until the API key,
# API secret AND webhook secret are all set.
DERIV_API_KEY=
DERIV_API_SECRET=
DERIV_APP_ID=
DERIV_BASE_URL=https://api.deriv.com
DERIV_WEBHOOK_SECRET=

# Weltrade (https://api.weltrade.com) — gateway stays DISABLED until the API
# key, API secret AND webhook secret are all set.
WELTRADE_API_KEY=
WELTRADE_API_SECRET=
WELTRADE_BASE_URL=https://api.weltrade.com
WELTRADE_WEBHOOK_SECRET=

# Official Weltrade sign-up link shown by the dashboard's "Create a Weltrade
# Account" button. Must be a real http(s) URL you were given — never a guessed
# referral link. Admins can override it at runtime in Admin → Weltrade Accounts
# (Setting table); the card shows a "not configured" notice while this is empty.
WELTRADE_REGISTER_URL=https://secure.weltrade.com

# Server-enforced limits (the client never decides what is allowed).
# These are the STARTUP DEFAULTS only — admins override them at runtime in
# Admin → Broker Funds → Limits (stored in the Setting table, no redeploy).
BROKER_DEPOSIT_MIN=10
BROKER_DEPOSIT_MAX=50000
BROKER_WITHDRAWAL_MIN=10
BROKER_WITHDRAWAL_MAX=50000
BROKER_WITHDRAWAL_DAILY_MAX=20000
BROKER_PENDING_LIMIT=5
# Admin fee on deposits (% of the amount). Default 0; admins set the real
# rate at runtime. Snapshotted on each deposit row when it is created.
BROKER_DEPOSIT_FEE_PCT=0

# ATG wallet withdrawal limits and fee (manual payout until a provider is configured).
WALLET_WITHDRAWAL_MIN=1
WALLET_WITHDRAWAL_MAX=50000
WALLET_WITHDRAWAL_FEE_PCT=0

# ---- Catalogue rules ----
# Free courses are capped so the paid catalogue stays the main offer.
MAX_FREE_COURSES=5

# Public base URL used in webhooks / notification links
PUBLIC_URL=http://localhost:5273

# ---- Production hardening (only matters with NODE_ENV=production) ----
# The server REFUSES to boot in production while JWT_SECRET / JWT_REFRESH_SECRET
# are missing, shorter than 32 chars or still the dev defaults. Generate them:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# CORS allowlist (comma separated). Anything not listed is rejected in prod.
ALLOWED_ORIGINS=https://yourdomain.com
# Number of reverse-proxy hops in front of the API (false | 1 | 2 | ip list).
# Required for correct client IPs in rate limiting when behind nginx/cloudflare.
TRUST_PROXY=false
# Global API rate limit + much tighter bucket for /api/auth.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Serve the built client (client/dist) from this server — one origin, no Vite.
#   auto = serve whenever a build exists (recommended) | true | false
SERVE_CLIENT=auto
# Override the build folder if it lives elsewhere:
# CLIENT_DIST=/var/www/atg/client/dist

# Payment proof images are private and never served from the public client folder.
# Defaults to server/private/purchase-proofs; use a durable, access-restricted
# directory in production.
# PURCHASE_PROOF_DIR=/var/lib/atg/purchase-proofs
