
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  name         String
  role         String    @default("USER") // USER | ADMIN
  membership   String    @default("FREE") // FREE | PAID | VIP_DERIV | VIP_WELTRADE
  avatarUrl    String?   @db.Text
  bio          String?   @db.Text
  country      String?
  isVip        Boolean   @default(false)
  vipExpiresAt DateTime?

  phoneE164           String?   @unique
  nationality         String?
  dateOfBirth         DateTime?
  address             String?   @db.Text
  securityQuestion    String?
  securityAnswerHash  String?
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  recoveryAttempts    Int       @default(0)
  recoveryLockedUntil DateTime?

  refreshTokenHash      String?
  refreshTokenPrevHash  String?
  refreshTokenExpiresAt DateTime?
  refreshTokenRotatedAt DateTime?
  refreshTokenRevokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet        Wallet?
  signals       Signal[]           @relation("SignalAuthor")
  enrollments   Enrollment[]
  purchases     Purchase[]
  transactions  Transaction[]
  subscription  Subscription?
  pushSubs      PushSubscription[]
  notifications Notification[]
  groupPosts    GroupPost[]
  messages      Message[]
  likes         PostLike[]
  comments      Comment[]
  createdGroups Group[]            @relation("GroupOwner")
  memberships   GroupMember[]
  watchlist     WatchlistItem[]
  certificates  Certificate[]

  brokerTransactions    BrokerTransaction[]
  brokerBalances        BrokerBalance[]
  brokerAccounts        BrokerAccount[]
  securityEvents        SecurityEvent[]
  receipts              Receipt[]
  refunds               Refund[]
  purchaseRequests      PurchaseRequest[]      @relation("PurchaseRequestOwner")
  reviewedRequests      PurchaseRequest[]      @relation("PurchaseRequestReviewer")
  purchaseRequestEvents PurchaseRequestEvent[] @relation("PurchaseRequestEventActor")
  membershipRoomAccess  MembershipRoomAccess[]
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  phoneE164 String?
  type      String // REGISTER | LOGIN_* | RECOVERY_* | PASSWORD_*
  ip        String?
  userAgent String?  @db.Text
  meta      String?  @db.Text // JSON, never secrets
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([phoneE164, createdAt])
  @@index([type, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signal {
  id          String    @id @default(cuid())
  pair        String // e.g. Volatility 75 (V75)
  market      String    @default("Derived")
  direction   String // BUY | SELL
  entry       Float
  takeProfit  Float
  stopLoss    Float
  timeframe   String    @default("15m")
  tier        String    @default("FREE") // FREE | VIP (legacy mirror of audience)
  audience    String    @default("FREE") // FREE | PAID | VIP_DERIV | VIP_WELTRADE
  status      String    @default("OPEN") // OPEN | HIT_TP | HIT_SL | CANCELLED
  resultPips  Float?
  resultPct   Float?
  analysis    String?   @db.Text
  chartUrl    String?   @db.Text
  roomPostId  String? // mirrored GroupPost in the matching room (auto-managed)
  publishedAt DateTime  @default(now())
  closedAt    DateTime?
  authorId    String?
  author      User?     @relation("SignalAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tier, status])
  @@index([pair])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  level       String   @default("Beginner") // Beginner | Intermediate | Advanced
  price       Float    @default(0)
  currency    String   @default("USD")
  saleStatus  String   @default("AVAILABLE") // AVAILABLE | UNAVAILABLE | HIDDEN | SOLD_OUT
  isVip       Boolean  @default(false)
  coverUrl    String?  @db.Text
  durationMin Int      @default(0)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons          Lesson[]
  resources        Resource[]
  enrollments      Enrollment[]
  purchaseRequests PurchaseRequest[]
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  videoUrl    String?  @db.Text
  durationMin Int      @default(0)
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  progress LessonProgress[]
}

model Resource {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String
  type      String   @default("PDF") // PDF | EBOOK | SHEET
  url       String   @db.Text
  sizeKb    Int      @default(0)
  isVip     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress   Int      @default(0) // 0-100
  completed  Boolean  @default(false)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  secondsSeen Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Purchase {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType               String // COURSE | RESOURCE | SUBSCRIPTION
  itemId                 String
  itemTitle              String
  amount                 Float
  currency               String    @default("USD")
  status                 String    @default("PENDING") // PENDING | PROCESSING | PAID | FAILED | REFUNDED | DISPUTED
  provider               String    @default("stripe") // stripe | manual | free
  providerRef            String? // merchant reference (ATG-...) or Stripe session id
  method                 String? // payment method chosen for manual/local payments
  proofNote              String?   @db.Text // reference / details submitted by the buyer
  providerPollUrl        String?   @map("paynowPollUrl") @db.Text
  providerTransactionRef String?   @map("paynowReference")
  verifiedById           String?
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  payment         Payment?
  receipt         Receipt?
  refunds         Refund[]
  purchaseRequest PurchaseRequest?

  @@index([userId, status])
}

model MembershipPackage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  durationDays   Int
  activationRule String   @default("APPROVAL") // APPROVAL | AFTER_CURRENT_ACCESS
  includedRooms  String   @db.Text // JSON: VIP_DERIV and/or VIP_WELTRADE
  saleStatus     String   @default("AVAILABLE") // AVAILABLE | UNAVAILABLE | HIDDEN | SOLD_OUT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseRequests PurchaseRequest[]

  @@index([saleStatus])
}

model PurchaseRequest {
  id                      String             @id @default(cuid())
  reference               String             @unique
  userId                  String
  user                    User               @relation("PurchaseRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewerId              String?
  reviewer                User?              @relation("PurchaseRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  itemType                String // COURSE | MEMBERSHIP
  courseId                String?
  course                  Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  membershipPackageId     String?
  membershipPackage       MembershipPackage? @relation(fields: [membershipPackageId], references: [id], onDelete: SetNull)
  itemTitleSnapshot       String
  itemDescriptionSnapshot String?            @db.Text
  amountSnapshot          Decimal            @db.Decimal(12, 2)
  currencySnapshot        String
  durationDaysSnapshot    Int?
  activationRuleSnapshot  String?
  includedRoomsSnapshot   String?            @db.Text
  amountPaid              Decimal            @db.Decimal(12, 2)
  paymentMethod           String
  paymentReference        String
  paymentDate             DateTime?
  proofStorageName        String
  proofMimeType           String
  proofSizeBytes          Int
  customerNote            String?            @db.Text
  status                  String             @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | CANCELLED
  duplicateReference      Boolean            @default(false)
  decisionAt              DateTime?
  decisionReason          String?            @db.Text
  customerMessage         String?            @db.Text
  internalNotes           String?            @db.Text
  approvalReference       String?            @unique
  purchaseId              String?            @unique
  purchase                Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  events                PurchaseRequestEvent[]
  membershipAccess      MembershipRoomAccess[]
  paymentReferenceClaim PaymentReferenceClaim?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentReference])
}

model PurchaseRequestEvent {
  id              String          @id @default(cuid())
  requestId       String
  request         PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?           @relation("PurchaseRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action          String
  fromStatus      String?
  toStatus        String?
  reason          String?         @db.Text
  customerMessage String?         @db.Text
  internalNotes   String?         @db.Text
  details         String?         @db.Text
  createdAt       DateTime        @default(now())

  @@index([requestId, createdAt])
}

model MembershipRoomAccess {
  id                String                             @id @default(cuid())
  userId            String
  user              User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId         String
  request           PurchaseRequest                    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  accessLevel       String // VIP_DERIV | VIP_WELTRADE
  startsAt          DateTime
  expiresAt         DateTime
  approvalReference String
  createdAt         DateTime                           @default(now())
  expiryNotices     MembershipRoomAccessExpiryNotice[]

  @@unique([requestId, accessLevel])
  @@index([userId, accessLevel, expiresAt])
}

model MembershipRoomAccessExpiryNotice {
  id                     String               @id @default(cuid())
  membershipRoomAccessId String
  membershipRoomAccess   MembershipRoomAccess @relation(fields: [membershipRoomAccessId], references: [id], onDelete: Cascade)
  milestone              String // THREE_DAYS | ONE_DAY | EXPIRED
  createdAt              DateTime             @default(now())

  @@unique([membershipRoomAccessId, milestone])
  @@index([createdAt])
}

model PaymentReferenceClaim {
  reference String          @id
  requestId String          @unique
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String   @default("VIP_MONTHLY")
  status      String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED | PENDING
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  autoRenew   Boolean  @default(true)
  provider    String   @default("stripe")
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // DEPOSIT | WITHDRAWAL | PURCHASE | REFUND | SUBSCRIPTION
  method         String? // BANK_TRANSFER | ECOCASH | ONEMONEY | USDT_TRC20 | CARD
  amount         Float
  fee            Float     @default(0)
  netAmount      Float?
  currency       String    @default("USD")
  status         String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  reference      String    @unique
  idempotencyKey String?   @unique
  note           String?   @db.Text
  destination    String?   @db.Text
  providerRef    String?
  adminNote      String?   @db.Text
  processedById  String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  statusHistory TransactionStatusHistory[]

  @@index([userId, status])
}

model TransactionStatusHistory {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  actorId       String?
  actorRole     String
  note          String?
  createdAt     DateTime    @default(now())

  @@index([transactionId, createdAt])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  category    String   @default("General") // Analysis | Wins | Questions | General
  visibility  String   @default("PUBLIC") // PUBLIC | VIP (legacy)
  accessTier  String   @default("FREE") // FREE | PAID | VIP_DERIV | VIP_WELTRADE
  roomType    String   @default("GENERAL") // GENERAL | DERIV | WELTRADE
  isChatOpen  Boolean  @default(true)
  ownerId     String?
  owner       User?    @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  members  GroupMember[]
  posts    GroupPost[]
  messages Message[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // MEMBER | MODERATOR
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model GroupPost {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      String   @default("POST") // POST | ANALYSIS | WIN | QUESTION
  body      String   @db.Text
  imageUrl  String?  @db.Text
  createdAt DateTime @default(now())

  likes    PostLike[]
  comments Comment[]

  @@index([groupId, createdAt])
}

model PostLike {
  id     String    @id @default(cuid())
  postId String
  post   GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String    @db.Text
  createdAt DateTime  @default(now())
}

model Message {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  type      String   @default("SYSTEM") // SIGNAL | SUBSCRIPTION | SYSTEM | EDUCATION | PAYMENT
  read      Boolean  @default(false)
  link      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(700)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pair      String
  createdAt DateTime @default(now())

  @@unique([userId, pair])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  title    String   @default("")
  issuedAt DateTime @default(now())
}


model BrokerTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction String // DEPOSIT | WITHDRAWAL
  broker    String // DERIV | WELTRADE
  amount    Float
  currency  String @default("USD")
  method    String // ECOCASH | ONEMONEY | INNBUCKS | CASHSMILE | BANK_TRANSFER

  feePct    Float @default(0)
  feeAmount Float @default(0)

  status String @default("PENDING")

  reference      String @unique // ATG-BD-xxxx / ATG-BW-xxxx (shown to the customer)
  idempotencyKey String @unique // client-supplied or server-generated; blocks double submits

  paymentReference  String?
  destination       String? @db.Text
  destinationMasked String? @db.Text
  destinationType   String? // MOBILE_WALLET | BANK_ACCOUNT | BROKER_ACCOUNT

  provider     String  @default("manual") // manual | deriv | weltrade
  providerRef  String? // reference returned by the payment provider / broker
  evidence     String? @db.Text // proof the money actually moved (webhook id, stmt line)
  evidenceType String? // PROVIDER_WEBHOOK | MANUAL_RECONCILIATION

  adminNote     String? @db.Text // visible note returned to the customer
  internalNote  String? @db.Text // staff-only note, never returned to the customer
  failureReason String? @db.Text

  processedById String?
  processedAt   DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit BrokerAuditLog[]

  @@index([userId, createdAt])
  @@index([broker, direction, status])
  @@index([status, createdAt])
}

model BrokerAuditLog {
  id            String             @id @default(cuid())
  transactionId String?
  transaction   BrokerTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  action     String // CREATED | REVIEW | APPROVE | START_PROCESSING | COMPLETE | REJECT | FAIL | NOTE | WEBHOOK | BALANCE_SYNC
  fromStatus String?
  toStatus   String?
  source     String  @default("ADMIN") // CUSTOMER | ADMIN | PROVIDER | SYSTEM
  provider   String?
  eventId    String? // external idempotency key for provider events

  actorId   String?
  actorRole String? // USER | ADMIN | SYSTEM
  actorName String?

  note     String? @db.Text
  metadata String? @db.Text // JSON blob (amounts, provider refs, raw event summary)

  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([transactionId, createdAt])
  @@index([action, createdAt])
}

model BrokerBalance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       String // DERIV | WELTRADE
  currency     String    @default("USD")
  balance      Float
  source       String    @default("MANUAL") // PROVIDER_API | MANUAL_RECONCILIATION
  reference    String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, broker, currency])
  @@index([broker, verifiedAt])
}

model Setting {
  key         String   @id
  value       String   @db.Text
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Payment {
  id         String   @id @default(cuid())
  purchaseId String   @unique
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  userId     String

  reference              String  @unique
  providerTransactionRef String? @unique @map("paynowReference")
  providerPollUrl        String? @map("pollUrl") @db.Text

  status   String  @default("CREATED")
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  statusUpdates   Int       @default(0)
  firstNotifiedAt DateTime?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PaymentEvent[]

  @@index([status])
  @@index([userId])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  purchaseId String?

  source    String // RESULT_NOTIFICATION | POLL | ADMIN | SYSTEM
  status    String?
  hashValid Boolean
  eventId   String  @unique
  body      String  @db.Text
  ip        String?
  processed Boolean @default(false) // did this event trigger the fulfil logic?
  note      String? @db.Text

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique // ATG-RCPT-XXXXXXXX shown to the customer
  purchaseId    String   @unique
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemTitle     String
  itemType      String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  method        String?
  paidAt        DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Refund {
  id            String    @id @default(cuid())
  purchaseId    String
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("USD")
  reason        String    @db.Text
  status        String    @default("REQUESTED")
  adminNote     String?   @db.Text
  providerRef   String?
  requestedById String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model PaymentAuditLog {
  id         String   @id @default(cuid())
  action     String // CHECKOUT_INITIATED | CALLBACK_RECEIVED | CALLBACK_HASH_INVALID | FULFILLED | REFUND_REQUESTED | ...
  source     String // PROVIDER_CALLBACK | POLL | USER | ADMIN | SYSTEM
  purchaseId String?
  paymentId  String?
  refundId   String?
  actorId    String?
  actorRole  String?
  note       String?  @db.Text
  metadata   String?  @db.Text // JSON — never contains secrets/keys
  createdAt  DateTime @default(now())

  @@index([purchaseId, createdAt])
  @@index([action, createdAt])
}


model BrokerAccount {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker   String @default("WELTRADE") // DERIV | WELTRADE
  clientId String

  status       String  @default("PENDING")
  rejectReason String? @db.Text

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BrokerAccountEvent[]

  @@unique([userId, broker])
  @@index([status, createdAt])
}

model BrokerAccountEvent {
  id        String        @id @default(cuid())
  accountId String
  account   BrokerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  action     String // SUBMITTED | RESUBMITTED | VERIFIED | REJECTED
  fromStatus String?
  toStatus   String?
  reason     String? @db.Text

  actorId   String?
  actorRole String? // USER | ADMIN
  actorName String?

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}
